# ══════════════════════════════════════════════════════════════════
# ClimateSphere AI — Environment Configuration Template
# Copy to .env for local overrides. Never commit sensitive secrets.
# ══════════════════════════════════════════════════════════════════

# Environment Setting: development | staging | production
NODE_ENV=development

# Frontend & Reverse Proxy Ports
HTTP_PORT=8088
HTTPS_PORT=8443

# Edge Gateway Ingestion Microservice
EDGE_PORT=8089
EDGE_HOST=0.0.0.0
SIMULATION_INTERVAL_MS=1000

# PostgreSQL / TimescaleDB Industrial Connection
POSTGRES_USER=climatesphere
POSTGRES_PASSWORD=replace_with_strong_production_vault_password_2026
POSTGRES_DB=climatesphere_tsdb
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# JWT Cryptographic Signing & Session Secrets
JWT_SECRET=cs_sec_9f81a7b32c4e6d5a1098ef32145bc7a90184ef63d21a50b89234ef01824ef
JWT_EXPIRATION_SEC=3600
JWT_REFRESH_EXPIRATION_SEC=604800

# Enterprise OIDC / Identity Provider Integration (Azure Entra ID / Okta)
OIDC_ISSUER=https://login.microsoftonline.com/common/v2.0
OIDC_CLIENT_ID=cs-enterprise-app-client-id
OIDC_CLIENT_SECRET=replace_with_azure_app_secret
OIDC_AUDIENCE=api://climatesphere-industrial

# Industrial Telemetry Brokers
MQTT_BROKER_URL=tls://mqtt-broker.climatesphere.internal:8883
OPCUA_ENDPOINT=opc.tcp://10.14.82.10:4840/ClimateSphere
MODBUS_TCP_HOST=10.14.82.20
MODBUS_TCP_PORT=502

# AI / Google Gemini 2.0 Inference Engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Multi-Tenant Default Context
DEFAULT_TENANT_ID=tenant-eu-energy
DEFAULT_FACILITY_ID=DU-03
